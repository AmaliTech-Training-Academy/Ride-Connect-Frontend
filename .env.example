VITE_API_BASE_URL=https://your-api.example.com

# Optional: these are already the built-in defaults. Not secrets, since an
# unsigned upload exposes them to the browser. Never put the API secret here.
VITE_CLOUDINARY_CLOUD_NAME=mauricious
VITE_CLOUDINARY_UPLOAD_PRESET=rideConnect profile pictures

# Optional: email domains allowed to register, comma-separated. This is the
# built-in default. Keep it in step with the backend's list, which is the
# real check; the frontend one only gives earlier feedback.
VITE_ALLOWED_EMAIL_DOMAINS=amalitech.com,amalitechtraining.org
